# Copy only if root .env does not already exist. Never overwrite existing credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Leave blank until you configure Neon. Never put secrets in VITE_ variables.
DATABASE_URL=
DIRECT_URL=
# Exact public hostnames you own or are authorized to test, comma-separated.
# No wildcards, URLs or ports. Empty disables intake. No websites are fetched in Phase 1.
SCAN_ALLOWED_HOSTS=
# Explicit migration guard: set only after verifying BOTH URLs are an isolated dev/test branch.
DATABASE_TARGET_CONFIRMED=
# Neon pooled URL format (replace every placeholder in your private .env):
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DATABASE?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/DATABASE?sslmode=require
# Vite proxies /api to this origin in development; this is not a browser secret.
API_PROXY_TARGET=http://127.0.0.1:3001

{
  "name": "accesslens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "prepare": "npm run build --workspace @accesslens/shared && npm run db:generate",
    "dev": "concurrently -k -n API,WEB -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @accesslens/web",
    "dev:api": "npm run dev --workspace @accesslens/api",
    "build": "npm run build --workspace @accesslens/shared && npm run build --workspace @accesslens/api && npm run build --workspace @accesslens/web",
    "start:api": "npm run start --workspace @accesslens/api",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:validate": "node scripts/database-cli.mjs validate",
    "db:generate": "node scripts/database-cli.mjs generate",
    "db:check": "node scripts/database-cli.mjs check",
    "db:migrate": "node scripts/database-cli.mjs migrate",
    "db:status": "node scripts/database-cli.mjs status",
    "test:database": "node scripts/test-database.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run db:validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.0.18"
  }
}
